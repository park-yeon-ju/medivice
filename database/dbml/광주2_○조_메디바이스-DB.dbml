// 메디바이스 전체 물리 스키마 — sql/01_schema_ddl.sql 및 PostgreSQL medivice 스키마 기준
// 29개 테이블 · PK/FK/UNIQUE 반영 · 2026-09-03 검증
Project medivice {
  database_type: 'PostgreSQL'
  Note: '공공 API 참조 데이터와 서비스 데이터를 ingredients 중심으로 연결한 전체 물리 스키마'
}

Table ingredients [headercolor: #2E86C1] {
  ingredient_id            bigint [pk, increment, not null]
  ingr_code                varchar(20) [not null, unique]
  name_ko                  varchar(300) [not null]
  name_en                  varchar(200)
  created_at               timestamptz [not null, default: `now()`]
}

Table manufacturers [headercolor: #2E86C1] {
  manufacturer_id          bigint [pk, increment, not null]
  name                     varchar(200) [not null, unique]
  biz_no                   varchar(20)
}

Table products [headercolor: #2E86C1] {
  product_id               bigint [pk, increment, not null]
  item_seq                 varchar(20) [not null, unique]
  name_ko                  varchar(500) [not null]
  manufacturer_id          bigint
  product_type             varchar(20) [not null]
  chart                    varchar(300)
  image_url                text
  updated_at               timestamptz [not null, default: `now()`]
}

Table product_ingredients [headercolor: #E67E22] {
  product_id               bigint [not null]
  ingredient_id            bigint [not null]
  amount                   "numeric(12,3)"
  unit                     varchar(20)

  indexes {
    (product_id, ingredient_id) [pk]
  }
}

Table product_infos [headercolor: #2E86C1] {
  product_id               bigint [pk, not null]
  efficacy                 text
  usage_method             text
  warning                  text
  caution                  text
  interaction              text
  side_effect              text
  storage                  text
}

Table dur_types [headercolor: #8E44AD] {
  dur_type_id              integer [pk, increment, not null]
  code                     varchar(30) [not null, unique]
  name_ko                  varchar(50) [not null]
  arity                    varchar(10) [not null]
  severity                 varchar(10) [not null]
}

Table dur_single_rules [headercolor: #2E86C1] {
  rule_id                  bigint [pk, increment, not null]
  dur_type_id              integer [not null]
  ingredient_id            bigint [not null]
  prohibit_content         text
  condition_min            "numeric(12,3)"
  condition_max            "numeric(12,3)"
  condition_unit           varchar(20)
  notification_date        date
  rule_version             varchar(30) [not null, default: `'MFDS-DUR'::character varying`]
  source_ref               text [not null, default: `'https://www.data.go.kr/data/15059486/openapi.do'::text`]
  checked_at               timestamptz [not null, default: `now()`]

  indexes {
    (dur_type_id, ingredient_id, condition_min, condition_max) [unique]
  }
}

Table dur_pair_rules [headercolor: #2E86C1] {
  pair_id                  bigint [pk, increment, not null]
  dur_type_id              integer [not null]
  ingredient_a_id          bigint [not null]
  ingredient_b_id          bigint [not null]
  prohibit_content         text
  notification_date        date
  rule_version             varchar(30) [not null, default: `'MFDS-DUR'::character varying`]
  source_ref               text [not null, default: `'https://www.data.go.kr/data/15056780/openapi.do'::text`]
  checked_at               timestamptz [not null, default: `now()`]

  indexes {
    (dur_type_id, ingredient_a_id, ingredient_b_id) [unique]
  }
}

Table effect_groups [headercolor: #2E86C1] {
  effect_group_id          integer [pk, increment, not null]
  name                     varchar(100) [not null, unique]
  series_name              varchar(200)
  source_ref               text [not null, default: `'https://www.data.go.kr/data/15059486/openapi.do'::text`]
  checked_at               timestamptz [not null, default: `now()`]
}

Table ingredient_effect_groups [headercolor: #E67E22] {
  ingredient_id            bigint [not null]
  effect_group_id          integer [not null]

  indexes {
    (ingredient_id, effect_group_id) [pk]
  }
}

Table ingredient_daily_limits [headercolor: #2E86C1] {
  ingredient_id            bigint [pk, not null]
  max_qty                  "numeric(12,3)" [not null]
  unit                     varchar(20) [not null]
  age_group                varchar(20) [not null, default: `'ADULT'::character varying`]
  rule_version             varchar(30) [not null, default: `'MFDS-DUR'::character varying`]
  source_ref               text [not null, default: `'https://www.data.go.kr/data/15059486/openapi.do'::text`]
  checked_at               timestamptz [not null, default: `now()`]
}

Table users [headercolor: #16A085] {
  user_id                  bigint [pk, increment, not null]
  login_id                 varchar(50) [not null, unique]
  password_hash            varchar(255) [not null]
  gender                   character(1)
  birth_date               date [not null]
  lang                     varchar(5) [not null, default: `'ko'::character varying`]
  created_at               timestamptz [not null, default: `now()`]
}

Table user_profiles [headercolor: #16A085] {
  user_id                  bigint [pk, not null]
  height_cm                "numeric(5,1)"
  weight_kg                "numeric(5,1)"
  is_pregnant              boolean
  renal_status             varchar(10)
  drink_freq               varchar(20)
  smoking                  boolean
  updated_at               timestamptz [not null, default: `now()`]
}

Table user_allergies [headercolor: #E67E22] {
  user_id                  bigint [not null]
  ingredient_id            bigint [not null]
  noted_at                 timestamptz [not null, default: `now()`]

  indexes {
    (user_id, ingredient_id) [pk]
  }
}

Table user_conditions [headercolor: #16A085] {
  condition_id             bigint [pk, increment, not null]
  user_id                  bigint [not null]
  name                     varchar(100) [not null]

  indexes {
    (user_id, name) [unique]
  }
}

Table departments [headercolor: #8E44AD] {
  department_id            integer [pk, increment, not null]
  name                     varchar(50) [not null, unique]
}

Table prescriptions [headercolor: #16A085] {
  prescription_id          bigint [pk, increment, not null]
  user_id                  bigint [not null]
  hospital_name            varchar(200)
  department_id            integer
  reason_detail            varchar(200)
  issued_date              date
  source                   varchar(10) [not null, default: `'OCR'::character varying`]
  created_at               timestamptz [not null, default: `now()`]
}

Table medications [headercolor: #16A085] {
  medication_id            bigint [pk, increment, not null]
  user_id                  bigint [not null]
  prescription_id          bigint
  product_id               bigint
  custom_name              varchar(300)
  dose_per_intake          "numeric(8,2)" [not null]
  times_per_day            smallint [not null]
  register_reason          varchar(200)
  started_at               date [not null, default: `CURRENT_DATE`]
  ended_at                 date
  source                   varchar(10) [not null, default: `'OCR'::character varying`]
  created_at               timestamptz [not null, default: `now()`]
  as_needed                boolean [not null, default: `false`]
}

Table medication_ingredients [headercolor: #E67E22] {
  medication_id            bigint [not null]
  ingredient_id            bigint [not null]
  amount                   "numeric(12,3)"
  unit                     varchar(20)

  indexes {
    (medication_id, ingredient_id) [pk]
  }
}

Table safety_checks [headercolor: #16A085] {
  check_id                 bigint [pk, increment, not null]
  user_id                  bigint [not null]
  level                    varchar(10) [not null]
  trigger_type             varchar(20) [not null]
  uncovered_count          smallint [not null, default: `0`]
  checked_at               timestamptz [not null, default: `now()`]
  amount_missing_count     smallint [not null, default: `0`]
}

Table safety_check_items [headercolor: #16A085] {
  item_id                  bigint [pk, increment, not null]
  check_id                 bigint [not null]
  dur_type_id              integer [not null]
  ingredient_id            bigint [not null]
  medication_a_id          bigint
  medication_b_id          bigint
  total_amount             "numeric(12,3)"
  threshold                "numeric(12,3)"
  level                    varchar(10) [not null]
  unit                     varchar(20)
  reason_code              varchar(40) [not null]
  source_ref               text
}

Table ai_outputs [headercolor: #16A085] {
  ai_output_id             bigint [pk, increment, not null]
  target_type              varchar(20) [not null]
  target_id                bigint [not null]
  prompt                   text [not null]
  result_json              jsonb
  status                   varchar(10) [not null, default: `'pending'::character varying`]
  created_at               timestamptz [not null, default: `now()`]
}

Table symptoms [headercolor: #8E44AD] {
  symptom_id               integer [pk, increment, not null]
  category                 varchar(30) [not null]
  name                     varchar(100) [not null]

  indexes {
    (category, name) [unique]
  }
}

Table side_effect_logs [headercolor: #16A085] {
  log_id                   bigint [pk, increment, not null]
  user_id                  bigint [not null]
  occurred_date            date [not null]
  written_at               timestamptz [not null, default: `now()`]
  note                     text
}

Table side_effect_symptoms [headercolor: #E67E22] {
  log_id                   bigint [not null]
  symptom_id               integer [not null]

  indexes {
    (log_id, symptom_id) [pk]
  }
}

Table side_effect_snapshots [headercolor: #16A085] {
  snapshot_id              bigint [pk, increment, not null]
  log_id                   bigint [not null]
  medication_id            bigint
  product_name             varchar(300) [not null]
  ingredient_text          text
}

Table reports [headercolor: #16A085] {
  report_id                bigint [pk, increment, not null]
  user_id                  bigint [not null]
  period_start             date [not null]
  period_end               date [not null]
  language                 varchar(5) [not null, default: `'ko'::character varying`]
  status                   varchar(10) [not null, default: `'pending'::character varying`]
  result_json              jsonb
  created_at               timestamptz [not null, default: `now()`]
}

Table family_links [headercolor: #16A085] {
  from_user_id             bigint [not null]
  to_user_id               bigint [not null]
  status                   varchar(10) [not null, default: `'INVITED'::character varying`]
  created_at               timestamptz [not null, default: `now()`]

  indexes {
    (from_user_id, to_user_id) [pk]
  }
}

Table notice_templates [headercolor: #8E44AD] {
  notice_code              varchar(40) [not null]
  lang                     varchar(5) [not null]
  message                  text [not null]

  indexes {
    (notice_code, lang) [pk]
  }
}

Ref: dur_pair_rules.dur_type_id > dur_types.dur_type_id
Ref: dur_pair_rules.ingredient_a_id > ingredients.ingredient_id
Ref: dur_pair_rules.ingredient_b_id > ingredients.ingredient_id
Ref: dur_single_rules.dur_type_id > dur_types.dur_type_id
Ref: dur_single_rules.ingredient_id > ingredients.ingredient_id
Ref: family_links.from_user_id > users.user_id
Ref: family_links.to_user_id > users.user_id
Ref: ingredient_daily_limits.ingredient_id > ingredients.ingredient_id
Ref: ingredient_effect_groups.effect_group_id > effect_groups.effect_group_id
Ref: ingredient_effect_groups.ingredient_id > ingredients.ingredient_id
Ref: medication_ingredients.ingredient_id > ingredients.ingredient_id
Ref: medication_ingredients.medication_id > medications.medication_id
Ref: medications.prescription_id > prescriptions.prescription_id
Ref: medications.product_id > products.product_id
Ref: medications.user_id > users.user_id
Ref: prescriptions.department_id > departments.department_id
Ref: prescriptions.user_id > users.user_id
Ref: product_infos.product_id > products.product_id
Ref: product_ingredients.ingredient_id > ingredients.ingredient_id
Ref: product_ingredients.product_id > products.product_id
Ref: products.manufacturer_id > manufacturers.manufacturer_id
Ref: reports.user_id > users.user_id
Ref: safety_check_items.check_id > safety_checks.check_id
Ref: safety_check_items.dur_type_id > dur_types.dur_type_id
Ref: safety_check_items.ingredient_id > ingredients.ingredient_id
Ref: safety_check_items.medication_a_id > medications.medication_id
Ref: safety_check_items.medication_b_id > medications.medication_id
Ref: safety_checks.user_id > users.user_id
Ref: side_effect_logs.user_id > users.user_id
Ref: side_effect_snapshots.log_id > side_effect_logs.log_id
Ref: side_effect_snapshots.medication_id > medications.medication_id
Ref: side_effect_symptoms.log_id > side_effect_logs.log_id
Ref: side_effect_symptoms.symptom_id > symptoms.symptom_id
Ref: user_allergies.ingredient_id > ingredients.ingredient_id
Ref: user_allergies.user_id > users.user_id
Ref: user_conditions.user_id > users.user_id
Ref: user_profiles.user_id > users.user_id
