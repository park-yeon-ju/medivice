Table "medivice"."ingredients" {
  "ingredient_id" BIGINT [pk, increment]
  "ingr_code" VARCHAR(20) [unique, not null]
  "name_ko" VARCHAR(200) [not null]
  "name_en" VARCHAR(200)
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
}

Table "medivice"."manufacturers" {
  "manufacturer_id" BIGINT [pk, increment]
  "name" VARCHAR(200) [unique, not null]
  "biz_no" VARCHAR(20)
}

Table "medivice"."products" {
  "product_id" BIGINT [pk, increment]
  "item_seq" VARCHAR(20) [unique, not null]
  "name_ko" VARCHAR(300) [not null]
  "manufacturer_id" BIGINT
  "product_type" VARCHAR(20) [not null]
  "chart" VARCHAR(300)
  "image_url" TEXT
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `product_type IN ('ETC','OTC','SUPPLEMENT')` [name: 'chk_product_type']
  }
}

Table "medivice"."product_ingredients" {
  "product_id" BIGINT [not null]
  "ingredient_id" BIGINT [not null]
  "amount" NUMERIC(12,3)
  "unit" VARCHAR(20)

  Indexes {
    (product_id, ingredient_id) [pk, name: "pk_product_ingredients"]
  }
}

Table "medivice"."product_infos" {
  "product_id" BIGINT [pk]
  "efficacy" TEXT
  "usage_method" TEXT
  "warning" TEXT
  "caution" TEXT
  "interaction" TEXT
  "side_effect" TEXT
  "storage" TEXT
}

Table "medivice"."dur_types" {
  "dur_type_id" INT [pk, increment]
  "code" VARCHAR(30) [unique, not null]
  "name_ko" VARCHAR(50) [not null]
  "arity" VARCHAR(10) [not null]
  "severity" VARCHAR(10) [not null]

  Checks {
    `arity    IN ('SINGLE','PAIR')` [name: 'chk_dur_arity']
    `severity IN ('RED','YELLOW','INFO')` [name: 'chk_dur_severity']
  }
}

Table "medivice"."dur_single_rules" {
  "rule_id" BIGINT [pk, increment]
  "dur_type_id" INT [not null]
  "ingredient_id" BIGINT [not null]
  "prohibit_content" TEXT
  "condition_min" NUMERIC(12,3)
  "condition_max" NUMERIC(12,3)
  "condition_unit" VARCHAR(20)
  "notification_date" DATE

  Indexes {
    (dur_type_id, ingredient_id, condition_min, condition_max) [unique, name: "uq_single_rule"]
  }
}

Table "medivice"."dur_pair_rules" {
  "pair_id" BIGINT [pk, increment]
  "dur_type_id" INT [not null]
  "ingredient_a_id" BIGINT [not null]
  "ingredient_b_id" BIGINT [not null]
  "prohibit_content" TEXT
  "notification_date" DATE

  Checks {
    `ingredient_a_id < ingredient_b_id` [name: 'chk_pair_order']
  }

  Indexes {
    (dur_type_id, ingredient_a_id, ingredient_b_id) [unique, name: "uq_pair_rule"]
  }
}

Table "medivice"."effect_groups" {
  "effect_group_id" INT [pk, increment]
  "name" VARCHAR(100) [unique, not null]
  "series_name" VARCHAR(200)
}

Table "medivice"."ingredient_effect_groups" {
  "ingredient_id" BIGINT [not null]
  "effect_group_id" INT [not null]

  Indexes {
    (ingredient_id, effect_group_id) [pk, name: "pk_ingredient_effect_groups"]
  }
}

Table "medivice"."ingredient_daily_limits" {
  "ingredient_id" BIGINT [pk]
  "max_qty" NUMERIC(12,3) [not null]
  "unit" VARCHAR(20) [not null]
  "age_group" VARCHAR(20) [not null, default: 'ADULT']

  Checks {
    `max_qty > 0` [name: 'chk_max_qty']
  }
}

Table "medivice"."users" {
  "user_id" BIGINT [pk, increment]
  "login_id" VARCHAR(50) [unique, not null]
  "password_hash" VARCHAR(255) [not null]
  "gender" CHAR(1)
  "birth_date" DATE [not null]
  "lang" VARCHAR(5) [not null, default: 'ko']
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `gender IN ('M','F')` [name: 'chk_user_gender']
    `lang   IN ('ko','en')` [name: 'chk_user_lang']
  }
}

Table "medivice"."user_profiles" {
  "user_id" BIGINT [pk]
  "height_cm" NUMERIC(5,1)
  "weight_kg" NUMERIC(5,1)
  "is_pregnant" BOOLEAN
  "renal_status" VARCHAR(10)
  "drink_freq" VARCHAR(20)
  "smoking" BOOLEAN
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `renal_status IN ('YES','NO','UNKNOWN')` [name: 'chk_renal']
  }
}

Table "medivice"."user_allergies" {
  "user_id" BIGINT [not null]
  "ingredient_id" BIGINT [not null]
  "noted_at" TIMESTAMPTZ [not null, default: `now()`]

  Indexes {
    (user_id, ingredient_id) [pk, name: "pk_user_allergies"]
  }
}

Table "medivice"."user_conditions" {
  "condition_id" BIGINT [pk, increment]
  "user_id" BIGINT [not null]
  "name" VARCHAR(100) [not null]

  Indexes {
    (user_id, name) [unique, name: "uq_user_condition"]
  }
}

Table "medivice"."departments" {
  "department_id" INT [pk, increment]
  "name" VARCHAR(50) [unique, not null]
}

Table "medivice"."prescriptions" {
  "prescription_id" BIGINT [pk, increment]
  "user_id" BIGINT [not null]
  "hospital_name" VARCHAR(200)
  "department_id" INT
  "reason_detail" VARCHAR(200)
  "issued_date" DATE
  "source" VARCHAR(10) [not null, default: 'OCR']
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `source IN ('OCR','MANUAL')` [name: 'chk_presc_source']
  }
}

Table "medivice"."medications" {
  "medication_id" BIGINT [pk, increment]
  "user_id" BIGINT [not null]
  "prescription_id" BIGINT
  "product_id" BIGINT
  "custom_name" VARCHAR(300)
  "dose_per_intake" NUMERIC(8,2) [not null]
  "times_per_day" SMALLINT [not null]
  "register_reason" VARCHAR(200)
  "started_at" DATE [not null, default: `CURRENT_DATE`]
  "ended_at" DATE
  "source" VARCHAR(10) [not null, default: 'OCR']
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `source IN ('OCR','MANUAL')` [name: 'chk_med_source']
    `times_per_day BETWEEN 1 AND 12` [name: 'chk_med_times']
    `ended_at IS NULL OR ended_at >= started_at` [name: 'chk_med_period']
    `product_id IS NOT NULL OR custom_name IS NOT NULL` [name: 'chk_med_identity']
  }
}

Table "medivice"."medication_ingredients" {
  "medication_id" BIGINT [not null]
  "ingredient_id" BIGINT [not null]
  "amount" NUMERIC(12,3)
  "unit" VARCHAR(20)

  Indexes {
    (medication_id, ingredient_id) [pk, name: "pk_medication_ingredients"]
  }
}

Table "medivice"."safety_checks" {
  "check_id" BIGINT [pk, increment]
  "user_id" BIGINT [not null]
  "level" VARCHAR(10) [not null]
  "trigger_type" VARCHAR(20) [not null]
  "uncovered_count" SMALLINT [not null, default: 0]
  "checked_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `level        IN ('GREEN','YELLOW','RED')` [name: 'chk_check_level']
    `trigger_type IN ('REGISTER','DELETE','MANUAL')` [name: 'chk_check_trigger']
    `uncovered_count >= 0` [name: 'chk_uncovered']
  }
}

Table "medivice"."safety_check_items" {
  "item_id" BIGINT [pk, increment]
  "check_id" BIGINT [not null]
  "dur_type_id" INT [not null]
  "ingredient_id" BIGINT [not null]
  "medication_a_id" BIGINT
  "medication_b_id" BIGINT
  "total_amount" NUMERIC(12,3)
  "threshold" NUMERIC(12,3)
  "level" VARCHAR(10) [not null]

  Checks {
    `level IN ('YELLOW','RED','INFO')` [name: 'chk_item_level']
  }
}

Table "medivice"."ai_outputs" {
  "ai_output_id" BIGINT [pk, increment]
  "target_type" VARCHAR(20) [not null]
  "target_id" BIGINT [not null]
  "prompt" TEXT [not null]
  "result_json" JSONB
  "status" VARCHAR(10) [not null, default: 'pending']
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `target_type IN ('SAFETY_CHECK','MEDICATION','REPORT')` [name: 'chk_ai_target']
    `status      IN ('pending','completed','failed')` [name: 'chk_ai_status']
  }
}

Table "medivice"."symptoms" {
  "symptom_id" INT [pk, increment]
  "category" VARCHAR(30) [not null]
  "name" VARCHAR(100) [not null]

  Indexes {
    (category, name) [unique, name: "uq_symptom"]
  }
}

Table "medivice"."side_effect_logs" {
  "log_id" BIGINT [pk, increment]
  "user_id" BIGINT [not null]
  "occurred_date" DATE [not null]
  "written_at" TIMESTAMPTZ [not null, default: `now()`]
  "note" TEXT

  Checks {
    `occurred_date <= CURRENT_DATE` [name: 'chk_log_not_future']
  }
}

Table "medivice"."side_effect_symptoms" {
  "log_id" BIGINT [not null]
  "symptom_id" INT [not null]

  Indexes {
    (log_id, symptom_id) [pk, name: "pk_side_effect_symptoms"]
  }
}

Table "medivice"."side_effect_snapshots" {
  "snapshot_id" BIGINT [pk, increment]
  "log_id" BIGINT [not null]
  "medication_id" BIGINT
  "product_name" VARCHAR(300) [not null]
  "ingredient_text" TEXT
}

Table "medivice"."reports" {
  "report_id" BIGINT [pk, increment]
  "user_id" BIGINT [not null]
  "period_start" DATE [not null]
  "period_end" DATE [not null]
  "language" VARCHAR(5) [not null, default: 'ko']
  "status" VARCHAR(10) [not null, default: 'pending']
  "result_json" JSONB
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `period_start <= period_end` [name: 'chk_report_period']
    `language IN ('ko','en')` [name: 'chk_report_lang']
    `status   IN ('pending','completed','failed')` [name: 'chk_report_status']
  }
}

Table "medivice"."family_links" {
  "from_user_id" BIGINT [not null]
  "to_user_id" BIGINT [not null]
  "status" VARCHAR(10) [not null, default: 'INVITED']
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `from_user_id <> to_user_id` [name: 'chk_family_self']
    `status IN ('INVITED','ACCEPTED','REJECTED')` [name: 'chk_family_status']
  }

  Indexes {
    (from_user_id, to_user_id) [pk, name: "pk_family_links"]
  }
}

Table "medivice"."notice_templates" {
  "notice_code" VARCHAR(40) [not null]
  "lang" VARCHAR(5) [not null]
  "message" TEXT [not null]

  Checks {
    `lang IN ('ko','en')` [name: 'chk_notice_lang']
  }

  Indexes {
    (notice_code, lang) [pk, name: "pk_notice_templates"]
  }
}

