// Foreign Key Relationships (37개 참조 관계)
// ---------------------------------------------------------------------------

Ref: dur_pair_rules.dur_type_id > dur_types.dur_type_id
Ref: dur_pair_rules.ingredient_a_id > ingredients.ingredient_id
Ref: dur_pair_rules.ingredient_b_id > ingredients.ingredient_id
Ref: dur_single_rules.dur_type_id > dur_types.dur_type_id
Ref: dur_single_rules.ingredient_id > ingredients.ingredient_id
