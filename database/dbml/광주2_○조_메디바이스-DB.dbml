Ref: medication_ingredients.ingredient_id > ingredients.ingredient_id
Ref: medication_ingredients.medication_id > medications.medication_id
Ref: medications.prescription_id > prescriptions.prescription_id
Ref: medications.product_id > products.product_id
Ref: medications.user_id > users.user_id
Ref: prescriptions.department_id > departments.department_id
Ref: prescriptions.user_id > users.user_id
Ref: product_infos.product_id > products.product_id
Ref: product_ingredients.ingredient_id > ingredients.ingredient_id
Ref: product_ingredients.product_id > products.product_id
Ref: products.manufacturer_id > manufacturers.manufacturer_id
Ref: reports.user_id > users.user_id
Ref: safety_check_items.check_id > safety_checks.check_id
Ref: safety_check_items.dur_type_id > dur_types.dur_type_id
Ref: safety_check_items.ingredient_id > ingredients.ingredient_id
Ref: safety_check_items.medication_a_id > medications.medication_id
Ref: safety_check_items.medication_b_id > medications.medication_id
Ref: safety_checks.user_id > users.user_id
Ref: side_effect_logs.user_id > users.user_id
Ref: side_effect_snapshots.log_id > side_effect_logs.log_id
Ref: side_effect_snapshots.medication_id > medications.medication_id
Ref: side_effect_symptoms.log_id > side_effect_logs.log_id
